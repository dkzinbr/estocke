# Runtime (obrigatórias em produção / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
APP_URL="https://estocke-adc.vercel.app/"

# Gere um segredo forte (não use placeholder em produção):
#   pnpm env:secret
#   pnpm env:secret -- --write   # grava no .env
JWT_SECRET="cole-aqui-o-resultado-de-pnpm-env-secret"

# Seed / QA (opcional — sobrescreve o admin padrão)
SEED_ADMIN_EMAIL="admin@estocke.local"
SEED_ADMIN_PASSWORD="troque-esta-senha"
SEED_ADMIN_NAME="Admin Estocke"
